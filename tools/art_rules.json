{
  "_说明": [
    "整理脚本（npm run art）靠这张表认图：文件名 → 切几行几格、每格多大、存到哪里。",
    "新增一种素材时，只要在 rules 里加一条，不用改脚本。",
    "name：文件名（不带 .png）。{id} 代表任意英文小写名字，例如 npc_{id}_stand 能匹配 npc_aqueer_stand。",
    "rows / cols：原图里排了几行、每行几格。",
    "cell：每格最后缩成多大（宽, 高），单位像素。",
    "sizes：（可选）按 {id} 单独指定格子大小，例如不同房子大小不一样。没写的用 cell。",
    "frames：每格叫什么，按从左到右、从上到下的顺序。",
    "out：存到 public/assets/ 下哪里。out 里有 {frame} 时，每格单独存一张图；没有 {frame} 就拼成一张精灵表（排法和原图一样）。",
    "tile：true 表示是地面纹理：不抠背景，只用品红空隙分格，每格拉满。",
    "full：true 表示是整张画（过场 CG）：不抠背景，从正中裁成目标比例（320×180 = 16:9）再缩小。",
    "skin：true 表示图里有人的皮肤：套色时皮肤只用调色板里的 5 个肤色（见 tools/art.mjs 的 TUNING.skin），脸不会发橙。",
    "fire：烛黄、橘火两种火光色默认不用；写 true（整条规则）或 [\"lantern\"]（只对这几张）才能用。会发光的东西（灯笼、烛台、火堆）和过场 CG 要写（见 tools/art.mjs 的 TUNING.fire）。",
    "uniformScale：true 表示整张图只用一个缩放比例：按最大的那一格算，所有格子用同一个比例缩小，再贴着格子底部居中。不写的话每一格会各自放大到撑满格子（种子会被放得和成熟的菜一样大）。作物、人物各个朝向、头像都要开。",
    "上面的规则从上往下找，用第一条匹配上的。"
  ],
  "rules": [
    {
      "name": "player_stand",
      "uniformScale": true,
      "skin": true,
      "rows": 1, "cols": 4, "cell": [16, 32],
      "frames": ["down", "left", "right", "up"],
      "out": "chars/player_stand.png"
    },
    {
      "name": "player_walk",
      "uniformScale": true,
      "skin": true,
      "rows": 4, "cols": 5, "cell": [16, 32],
      "frames": [
        "down_stand", "down_1", "down_2", "down_3", "down_4",
        "left_stand", "left_1", "left_2", "left_3", "left_4",
        "right_stand", "right_1", "right_2", "right_3", "right_4",
        "up_stand", "up_1", "up_2", "up_3", "up_4"
      ],
      "out": "chars/player_walk.png"
    },
    {
      "name": "npc_{id}_stand",
      "uniformScale": true,
      "skin": true,
      "rows": 1, "cols": 4, "cell": [16, 32],
      "frames": ["down", "left", "right", "up"],
      "out": "chars/npc_{id}_stand.png"
    },
    {
      "name": "npc_{id}_walk",
      "uniformScale": true,
      "skin": true,
      "rows": 4, "cols": 5, "cell": [16, 32],
      "frames": [
        "down_stand", "down_1", "down_2", "down_3", "down_4",
        "left_stand", "left_1", "left_2", "left_3", "left_4",
        "right_stand", "right_1", "right_2", "right_3", "right_4",
        "up_stand", "up_1", "up_2", "up_3", "up_4"
      ],
      "out": "chars/npc_{id}_walk.png"
    },
    {
      "name": "tiles_farm",
      "rows": 2, "cols": 3, "cell": [16, 16], "tile": true,
      "frames": ["grass", "dirt", "tilled", "watered", "path", "fence"],
      "out": "tiles/tiles_farm.png"
    },
    {
      "name": "tiles_water",
      "rows": 1, "cols": 2, "cell": [16, 16], "tile": true,
      "frames": ["water", "water_shimmer"],
      "out": "tiles/tiles_water.png"
    },
    {
      "name": "tiles_{id}",
      "rows": 2, "cols": 3, "cell": [16, 16], "tile": true,
      "frames": ["1", "2", "3", "4", "5", "6"],
      "out": "tiles/tiles_{id}.png"
    },
    {
      "name": "debris",
      "rows": 1, "cols": 4, "cell": [16, 16],
      "frames": ["weed", "rock", "stump", "fire"],
      "out": "objects/debris_{frame}.png"
    },
    {
      "name": "tree_{id}",
      "rows": 1, "cols": 1, "cell": [16, 32],
      "sizes": { "sapling": [16, 16], "small": [16, 32], "big": [32, 48] },
      "out": "objects/tree_{id}.png"
    },
    {
      "name": "prop_lantern",
      "fire": true,
      "rows": 1, "cols": 2, "cell": [16, 32],
      "frames": ["on", "off"],
      "out": "objects/prop_lantern.png"
    },
    {
      "name": "prop_mailbox",
      "rows": 1, "cols": 2, "cell": [16, 32],
      "frames": ["empty", "flag"],
      "out": "objects/prop_mailbox.png"
    },
    {
      "name": "prop_{id}",
      "rows": 1, "cols": 1, "cell": [16, 32],
      "sizes": { "tree": [16, 32], "basket": [16, 16], "gate": [16, 16] },
      "frames": ["main"],
      "out": "objects/prop_{id}.png"
    },
    {
      "name": "house_{id}",
      "rows": 1, "cols": 1, "cell": [48, 48],
      "sizes": { "straw_hut": [48, 48], "woodshed": [48, 48], "old_ruin": [64, 64], "timber_frame": [64, 64], "tiled_roof": [64, 64], "courtyard": [64, 64] },
      "frames": ["main"],
      "out": "buildings/house_{id}.png"
    },
    {
      "name": "crop_{id}",
      "uniformScale": true,
      "rows": 1, "cols": 5, "cell": [16, 32],
      "frames": ["seed", "sprout", "half", "ripe", "withered"],
      "fire": ["pumpkin"],
      "out": "crops/crop_{id}.png"
    },
    {
      "name": "icons_batch1",
      "rows": 2, "cols": 5, "cell": [16, 16],
      "frames": ["hoe", "bucket", "sickle", "axe", "mantou", "bok_choy_seed", "radish_seed", "bok_choy", "radish", "plant_ash"],
      "out": "icons/icon_{frame}.png"
    },
    {
      "name": "icons_batch2",
      "rows": 1, "cols": 3, "cell": [16, 16],
      "frames": ["pickaxe", "notebook", "burnt_paper"],
      "out": "icons/icon_{frame}.png"
    },
    {
      "name": "icons_batch3",
      "rows": 1, "cols": 4, "cell": [16, 16],
      "frames": ["wood", "thatch", "stone", "tree_seed"],
      "out": "icons/icon_{frame}.png"
    },
    {
      "name": "icons_materials",
      "rows": 1, "cols": 3, "cell": [16, 16],
      "frames": ["roof_tile", "brick", "firewood"],
      "out": "icons/icon_{frame}.png"
    },
    {
      "name": "icons_food",
      "fire": true,
      "rows": 1, "cols": 4, "cell": [16, 16],
      "frames": ["tea", "veg_porridge", "radish_soup", "roast_sweet_potato"],
      "out": "icons/icon_{frame}.png"
    },
    {
      "name": "icons_crops_1",
      "rows": 2, "cols": 2, "cell": [16, 16],
      "frames": ["pea_seed", "potato_seed", "pea", "potato"],
      "out": "icons/icon_{frame}.png"
    },
    {
      "name": "icons_crops_2",
      "fire": true,
      "rows": 2, "cols": 5, "cell": [16, 16],
      "frames": ["chive_seed", "chili_seed", "watermelon_seed", "taro_seed", "pumpkin_seed", "chive", "chili", "watermelon", "taro", "pumpkin"],
      "out": "icons/icon_{frame}.png"
    },
    {
      "name": "icons_crops_3",
      "rows": 2, "cols": 4, "cell": [16, 16],
      "frames": ["cucumber_seed", "eggplant_seed", "cowpea_seed", "sweet_potato_seed", "cucumber", "eggplant", "cowpea", "sweet_potato"],
      "out": "icons/icon_{frame}.png"
    },
    {
      "name": "icons_crops_4",
      "rows": 2, "cols": 4, "cell": [16, 16],
      "frames": ["napa_cabbage_seed", "spinach_seed", "garlic_seed", "mustard_greens_seed", "napa_cabbage", "spinach", "garlic", "mustard_greens"],
      "out": "icons/icon_{frame}.png"
    },
    {
      "name": "icons_ui",
      "rows": 1, "cols": 5, "cell": [16, 16],
      "frames": ["gear", "purse", "stamina", "lock", "backpack"],
      "out": "ui/icon_{frame}.png"
    },
    {
      "name": "portrait_{id}",
      "uniformScale": true,
      "skin": true,
      "rows": 1, "cols": 4, "cell": [64, 64],
      "frames": ["normal", "smile", "worried", "surprised"],
      "out": "portraits/portrait_{id}.png"
    },
    {
      "name": "ui_letter",
      "full": true,
      "rows": 1, "cols": 1, "cell": [256, 160],
      "out": "ui/ui_letter.png"
    },
    {
      "name": "cg_{id}",
      "full": true,
      "fire": true,
      "rows": 1, "cols": 1, "cell": [320, 180],
      "out": "cg/cg_{id}.png"
    }
  ]
}
